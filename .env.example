# Optional: set a non-empty password before the first start; no length or complexity requirements.
# Otherwise /data/admin-token.txt is generated inside the private volume.
# After initialization, change it in Settings > 管理密钥; changing this variable will not reset it.
NIUNO3_ADMIN_PASSWORD=
NIUNO3_BIND_ADDRESS=127.0.0.1
NIUNO3_PORT=8789
# Comma-separated IPs/CIDRs of trusted reverse proxies; empty disables proxy headers.
# For a host cloudflared + Docker, use the actual Docker network gateway IP.
NIUNO3_TRUSTED_PROXIES=
